# 의존성 모듈 폴더
node_modules/

# TypeScript 컴파일 출력 결과 폴더
dist/

# 민감한 환경변수 설정 파일 (API 키, DB 접속정보 등 절대 Git에 올리지 마세요!)
.env
.env.local
.env.*.local

# 로그 파일
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# 사용자가 업로드한 정적 파일 (기본 .gitkeep 제외하고 무시)
public/uploads/*
!public/uploads/.gitkeep

# 운영체제 및 에디터 임시 파일
.DS_Store
Thumbs.db
.vscode/
.idea/
